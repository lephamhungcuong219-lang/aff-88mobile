# ===== Docker Compose =====
# Local: để trống. VPS: proxy  (bật Caddy reverse proxy + HTTPS tự động)
COMPOSE_PROFILES=
# Ghim phiên bản n8n. Local và VPS dùng chung DB nên phải cùng phiên bản.
N8N_VERSION=2.45.5

# ===== Supabase PostgreSQL (Session pooler, port 5432) =====
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# Tuỳ chọn: tinh chỉnh connection pool (mặc định trong docker-compose.yml)
# DB_POSTGRESDB_POOL_SIZE=8
# DB_POSTGRESDB_CONNECTION_TIMEOUT=60000
# DB_POSTGRESDB_IDLE_CONNECTION_TIMEOUT=300000

# ===== n8n =====
# Phải GIỐNG HỆT key đã dùng lần đầu với DB này, nếu không sẽ không giải mã được credentials.
# Tạo mới: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# --- Local ---
# N8N_HOST=localhost
# N8N_PROTOCOL=http
# N8N_SECURE_COOKIE=false
# N8N_PROXY_HOPS=0
# N8N_WEBHOOK_URL=http://localhost:5678/
# N8N_EDITOR_BASE_URL=http://localhost:5678/

# --- VPS (domain đã trỏ A record về IP VPS) ---
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
N8N_SECURE_COOKIE=true
N8N_PROXY_HOPS=1
N8N_WEBHOOK_URL=https://n8n.example.com/
N8N_EDITOR_BASE_URL=https://n8n.example.com/

# Gemini (post_process/gemini_reorder.py)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
