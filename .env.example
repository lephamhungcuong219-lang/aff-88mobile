# ===== Docker Compose =====
# Local: để trống. VPS: proxy  (bật Caddy reverse proxy + HTTPS tự động)
COMPOSE_PROFILES=
# Ghim phiên bản n8n. Local và VPS dùng chung DB nên phải cùng phiên bản.
N8N_VERSION=2.45.5

# ===== Supabase PostgreSQL (Session pooler, port 5432) =====
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# Tuỳ chọn: tinh chỉnh connection pool (mặc định trong docker-compose.yml)
# DB_POSTGRESDB_POOL_SIZE=8
# DB_POSTGRESDB_CONNECTION_TIMEOUT=60000
# DB_POSTGRESDB_IDLE_CONNECTION_TIMEOUT=300000

# ===== n8n =====
# Phải GIỐNG HỆT key đã dùng lần đầu với DB này, nếu không sẽ không giải mã được credentials.
# Tạo mới: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# --- Local ---
# N8N_HOST=localhost
# N8N_PROTOCOL=http
# N8N_SECURE_COOKIE=false
# N8N_PROXY_HOPS=0
# N8N_WEBHOOK_URL=http://localhost:5678/
# N8N_EDITOR_BASE_URL=http://localhost:5678/

# --- VPS (domain đã trỏ A record về IP VPS) ---
# Caddy phục vụ n8n ở https://<N8N_HOST> và trang xem video final ở https://preview.<N8N_HOST>/?id=<jobId>.
# Cần thêm A record cho preview.<N8N_HOST> (hoặc wildcard *.<N8N_HOST>) về cùng IP.
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
N8N_SECURE_COOKIE=true
N8N_PROXY_HOPS=1
N8N_WEBHOOK_URL=https://n8n.example.com/
N8N_EDITOR_BASE_URL=https://n8n.example.com/

# Gemini (post_process/gemini_reorder.py)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
# Số video đầu ra TỐI ĐA cho mỗi video gốc (gemini_reorder). Để trống = Gemini tự quyết theo nội dung.
REORDER_TARGET_VIDEOS=4
# ... và tối thiểu bao nhiêu video: thiếu góc nội dung thì Gemini được làm ít hơn. Để trống = đúng REORDER_TARGET_VIDEOS.
REORDER_MIN_VIDEOS=3
# 1 = phải dùng hết mọi cảnh; 0 = chỉ chọn cảnh hay và hợp góc (mặc định 0).
REORDER_USE_ALL_SCENES=0
# Mạch lạc: trong một video, số chỗ nối đổi chủ đề tối đa bao nhiêu % (mặc định 45; 100 = không giới hạn).
REORDER_MAX_SWITCH_PERCENT=45
# 1 = đã rời một chủ đề thì không quay lại trong cùng video, trừ cụm mở đầu/kết ngắn (mặc định 1; 0 = tắt).
REORDER_KEEP_TOPICS_TOGETHER=1
# Số lần gọi Gemini tối đa để có kế hoạch đúng quy tắc: 1 lần đầu + các lần sửa (số nguyên từ 1, mặc định 4).
# Đạt thì dừng ngay; hết số lần mà vẫn sai thì bước này báo fail. Mỗi lần tốn 1 request.
REORDER_MAX_ATTEMPTS=2
# Thời lượng mục tiêu của mỗi video đầu ra (giây, gemini_reorder). Để trống = 15.
# Mỗi video được phép dài từ mục tiêu - 5 đến mục tiêu + 5 giây: 15 -> 10-20s, 10 -> 5-15s, 30 -> 25-35s.
# 0 = mục tiêu là độ dài video gốc (khoảng cho phép theo cùng công thức, ví dụ gốc 49s -> 44-54s),
# không bắt mỗi video dùng đủ mọi cảnh; một cảnh được dùng trong bao nhiêu video cũng được.
TARGET_VIDEO_S=15
# Mức dùng lại cảnh giữa các video đầu ra (gemini_reorder; không áp dụng khi TARGET_VIDEO_S=0). Để trống = mặc định.
# Một cảnh được dùng trong tối đa bao nhiêu video (mặc định 2).
REORDER_MAX_SCENE_USES=2
# Hai video dùng chung tối đa bao nhiêu % số cảnh của video ngắn hơn, để các video đa dạng (0-100, mặc định 50; 100 = không giới hạn).
REORDER_MAX_SHARED_PERCENT=50
# Mỗi đoạn trùng giữa hai video (các cảnh liên tiếp giống nhau, cùng thứ tự) dài tối đa bao nhiêu giây, luôn áp dụng
# dù dùng chung nhiều hay ít (mặc định 3; 0 = không giới hạn).
REORDER_MAX_SHARED_RUN_S=3
# Cắt cảnh (split_video): một cảnh quay liền dài hơn MAX giây được chia đều thành các phần không quá PART giây
# (mặc định 2.9 và 1.45; MAX=0 = không chia). Hai phần cạnh nhau <= 2 x PART: giữ 2 x PART <= REORDER_SOURCE_RUN_MAX_S
# để Gemini còn ghép liền lại được. TRIM = được bỏ tối đa bao nhiêu giây cuối cảnh để khỏi phải chia thêm một phần (mặc định 0.3).
SCENE_MAX_S=2.9
SCENE_PART_S=1.45
SCENE_TRIM_S=0.3
# Trùng với video gốc: các cảnh có số liền nhau (1, 2, 3...) đặt cạnh nhau trong một video output dài tối đa bao nhiêu giây.
# TARGET = mức yêu cầu Gemini nhắm tới (mặc định 2.7); MAX = mức tối đa chấp nhận, quá thì phải sửa (mặc định 2.9; 0 = không giới hạn).
# Áp dụng cả khi TARGET_VIDEO_S=0.
REORDER_SOURCE_RUN_TARGET_S=2.7
REORDER_SOURCE_RUN_MAX_S=2.9
# 1 = không nối thẳng hai cảnh cùng góc quay, hình gần như giống nhau (bị giật hình). 0 = tắt.
# Nếu 19, 20 và 21 có cùng cảnh nhưng sau khi cắt, model chọn 19 -> 21 thì không cho phép vì sẽ làm đoạn ở giữa bị giật
REORDER_AVOID_JUMP_CUTS=1

# Gemini TTS (post_process/gemini_tts.py)
# Model chính và model dự phòng khi model chính hết hạn mức ngày (để trống = không dự phòng)
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_FALLBACK_MODEL=gemini-3.1-flash-tts-preview
# Số request/phút cho phép của mỗi model TTS (theo tier, Tier 1 = 10)
GEMINI_TTS_RPM=10
# Danh sách giọng xoay vòng: mỗi video một giọng khác nhau (ngẫu nhiên, không trùng trong một vòng)
GEMINI_TTS_VOICES=Puck
# Câu hướng dẫn giọng vùng miền thêm vào phong cách đọc (để trống = không yêu cầu)
GEMINI_TTS_ACCENT=Use a natural Southern Vietnamese accent (Saigon / Ho Chi Minh City).
