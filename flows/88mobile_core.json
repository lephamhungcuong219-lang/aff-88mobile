        "command": "=uv run python -m post_process.split_video {{ $json.stdout.replace(/^mp4:/, '') }} {{ (p => p.split('/').slice(0, -2).join('/') + '/temp/' + p.split('/').pop().replace(/\\.mp4$/, '') + '/sources')($json.stdout.trim().replace(/^mp4:/, '')) }}"
